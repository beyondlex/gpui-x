+                    self.draw_monochrome_sprites(
                         texture_id,
                         range,
                         instance_bindings,
                         viewport_size,
                         command_encoder,
-                    ),
-                PrimitiveBatch::PolychromeSprites { texture_id, range } => self
-                    .draw_polychrome_sprites(
+                    );
